generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------- ENUMS ----------------

enum UserRole {
  ADMIN
  VENDOR
}

enum VendorStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RequestStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum InvitationStatus {
  INVITED
  VIEWED
  BID_SUBMITTED
  DECLINED
  EXPIRED
  SELECTED
  NOT_SELECTED
}

enum BidStatus {
  SUBMITTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum BookingStatus {
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ESEWA
  KHALTI
  OTHER
}

// ---------------- USER ----------------

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  passwordHash     String
  refreshTokenHash String?
  role             UserRole  @default(VENDOR)
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?

  vendor Vendor?

  createdEvents    Event[]        @relation("EventCreatedBy")
  createdRequests  EventRequest[] @relation("RequestCreatedBy")
  selectedBookings Booking[]      @relation("BookingSelectedBy")
  recordedPayments Payment[]      @relation("PaymentRecordedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ---------------- VENDOR ----------------

model Vendor {
  id            String       @id @default(cuid())
  userId        String       @unique
  businessName  String
  contactPerson String?
  phone         String?
  businessEmail String?
  address       String?
  description   String?
  status        VendorStatus @default(PENDING)

  bankName      String?
  accountName   String?
  accountNumber String?
  bankBranch    String?

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations VendorInvitation[]
  bookings    Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------- EVENT ----------------

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  venue       String
  location    String?
  guestCount  Int?
  clientName  String?
  clientPhone String?

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  requests EventRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventDate])
}

// ---------------- EVENT REQUEST ----------------

model EventRequest {
  id               String        @id @default(cuid())
  title            String
  description      String?
  status           RequestStatus @default(DRAFT)
  responseDeadline DateTime?
  sentAt           DateTime?

  eventId     String
  createdById String

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User  @relation("RequestCreatedBy", fields: [createdById], references: [id])

  items       RequestItem[]
  photos      RequestPhoto[]
  invitations VendorInvitation[]
  booking     Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([eventId])
}

// ---------------- REQUEST ITEMS ----------------

model RequestItem {
  id          String  @id @default(cuid())
  name        String
  description String?
  quantity    Int     @default(1)
  unit        String  @default("unit")

  requestId String
  request   EventRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  bidItems BidItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
}

// ---------------- REQUEST PHOTOS ----------------

model RequestPhoto {
  id       String  @id @default(cuid())
  imageUrl String
  publicId String?
  caption  String?

  requestId String
  request   EventRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([requestId])
}

// ---------------- VENDOR INVITATIONS ----------------

model VendorInvitation {
  id        String           @id @default(cuid())
  status    InvitationStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  viewedAt  DateTime?

  requestId String
  vendorId  String

  request EventRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor  Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  bid Bid?

  @@unique([requestId, vendorId])
  @@index([vendorId, status])
}

// ---------------- BIDS ----------------

model Bid {
  id          String    @id @default(cuid())
  totalAmount Decimal   @db.Decimal(12, 2)
  notes       String?
  validUntil  DateTime?
  submittedAt DateTime  @default(now())
  status      BidStatus @default(SUBMITTED)

  invitationId String           @unique
  invitation   VendorInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  items   BidItem[]
  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ---------------- BID ITEMS ----------------

model BidItem {
  id         String  @id @default(cuid())
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  notes      String?

  bidId         String
  requestItemId String

  bid         Bid         @relation(fields: [bidId], references: [id], onDelete: Cascade)
  requestItem RequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)

  @@unique([bidId, requestItemId])
}

// ---------------- BOOKINGS ----------------

model Booking {
  id            String        @id @default(cuid())
  bookingAmount Decimal       @db.Decimal(12, 2)
  status        BookingStatus @default(CONFIRMED)
  confirmedAt   DateTime      @default(now())
  notes         String?

  requestId    String @unique
  bidId        String @unique
  vendorId     String
  selectedById String

  request    EventRequest @relation(fields: [requestId], references: [id])
  bid        Bid          @relation(fields: [bidId], references: [id])
  vendor     Vendor       @relation(fields: [vendorId], references: [id])
  selectedBy User         @relation("BookingSelectedBy", fields: [selectedById], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, status])
}

// ---------------- PAYMENTS ----------------

model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(COMPLETED)
  method        PaymentMethod
  transactionId String?
  notes         String?
  paidAt        DateTime      @default(now())

  bookingId    String
  recordedById String

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId, status])
}
